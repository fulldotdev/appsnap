{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "appsnap",
  "title": "Appsnap",
  "description": "Capture the window behind the current app and paste it at your cursor.",
  "icon": "appsnap-icon.png",
  "author": "sil",
  "license": "MIT",
  "commands": [
    {
      "name": "appsnap",
      "title": "Appsnap",
      "description": "Capture the window behind and paste it at your cursor",
      "mode": "no-view"
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.104.23"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.19.17",
    "eslint": "^10.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
